# apps/api/.env  (Render: Environment)  — Quarkus lê .env em dev
DB_URL=jdbc:postgresql://localhost:54322/postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=5
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=<service_role / secret key — nunca no frontend>
CORS_ORIGINS=http://localhost:5173
BRAPI_TOKEN=<token brapi.dev>
JOBS_SECRET=dev-secret
