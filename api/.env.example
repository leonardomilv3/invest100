# api/.env (Quarkus lê .env em dev) · Render: Environment
DB_URL=jdbc:postgresql://localhost:54322/postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=5
# JWT RS256 emitido pela API. Dev: ./scripts/gen-jwt-keys.sh preenche as duas chaves abaixo.
# Prod: ./scripts/gen-jwt-keys.sh --print e cole no Render (par próprio de produção; nunca reutilize o de dev).
JWT_ISSUER=investidor100-api
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173
BRAPI_TOKEN=<token brapi.dev>
JOBS_SECRET=dev-secret
# Produção (exemplo):
# DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# CORS_ORIGINS=https://investidor100.vercel.app,/https://investidor100-.*-<time>\.vercel\.app/
